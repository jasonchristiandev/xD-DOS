CompileFlags:
  CompilationDatabase: .
  Add:
    - -fno-stack-protector
    - -ffreestanding
    - -mno-red-zone
    - -fms-extensions
    - -nostdlib
    - -nostdinc
    - -nobuiltininc
    - -Wall
    - -Wextra
    - -Wno-variadic-macros
    - -Wno-pointer-to-int-cast
    - -Wno-int-to-pointer-cast
    - -Wno-compare-distinct-pointer-types
    - -std=c11
    - -O2
    - -mno-mmx
    - -mno-sse
    - -mno-sse2
    - -Iinclude

Diagnostics:
  ClangTidy:
    Remove: [bugprone-unused-*, readability-redundant-*]