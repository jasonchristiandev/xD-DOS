CompileFlags:
  CompilationDatabase: "."
  Add: [
    "-xc",
    "-std=c11",
    "-fno-stack-protector",
    "-mno-red-zone",
    "-ffreestanding",
    "-fms-extensions",
    "-fno-builtin",
    "-Wno-pointer-to-int-cast",
    "-Wno-int-to-pointer-cast",
    "-Wno-compare-distinct-pointer-types"
  ]

Diagnostics:
  ClangTidy:
    Remove: [bugprone-unused-*, readability-redundant-*]